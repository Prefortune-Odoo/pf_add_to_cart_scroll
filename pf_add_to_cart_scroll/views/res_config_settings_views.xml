<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_website_sale_scroll" model="ir.ui.view">
        <field name="name">res.config.settings.view.website.sale.scroll</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//h2[normalize-space()='SEO']" position="before">

                    <h2>Bottom Add To Cart Popup h2</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="show_bottom_add_to_cart_popup"/>
                            </div>

                            <div class="o_setting_right_pane">
                                <label for="show_bottom_add_to_cart_popup"/>

                                <div class="text-muted">
                                    Show sticky Add To Cart popup when customer scrolls product page.
                                </div>

                                <div class="content-group mt16"
                                     attrs="{'invisible': [('show_bottom_add_to_cart_popup', '=', False)]}">


                                    <div class="row mt16">
                                        <label for="popup_style"
                                               class="col-lg-3 o_light_label">
                                            Popup Style
                                        </label>

                                        <field name="popup_style"
                                               class="col-lg-6"/>

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

            </xpath>
        </field>
    </record>
</odoo>

